# API INSEE SIRENE
INSEE_API_KEY=your-insee-api-key-here

# API RNE (INPI) - Token JWT
# Note: Ce token expire periodiquement, prevoir un renouvellement
RNE_JWT_TOKEN=your-rne-jwt-token-here

# Backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis (optionnel, pour cache)
REDIS_URL=redis://localhost:6379

# Rate limiting
INSEE_RATE_LIMIT=30
INSEE_RATE_PERIOD=60
